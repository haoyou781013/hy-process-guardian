#!/sbin/sh
#################
# Initialization
#################

umask 022

# echo before loading util_functions
ui_print() { echo "$1"; }

require_new_ksu() {
    ui_print "*******************************"
    ui_print " Please install KernelSU v0.6.0+ "
    ui_print "*******************************"
    exit 1
}

#########################
# Load util_functions.sh
#########################

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

[ -f /data/adb/ksu/bin/ksud ] || require_new_ksu

# KernelSU's ksud handles the install
exec /data/adb/ksu/bin/ksud install "$ZIPFILE"
